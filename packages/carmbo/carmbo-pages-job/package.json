{
  "name": "@giltayar/carmbo-pages-job",
  "version": "1.0.0",
  "description": "Job pages and background job execution for Carmbo applications",
  "type": "module",
  "exports": {
    "./routes": {
      "types": "./dist/src/routes.d.ts",
      "import": "./dist/src/routes.js"
    },
    "./jobs/executor": {
      "types": "./dist/src/job-executor.d.ts",
      "import": "./dist/src/job-executor.js"
    },
    "./jobs/handler": {
      "types": "./dist/src/job-handlers.d.ts",
      "import": "./dist/src/job-handlers.js"
    },
    "./testkit": {
      "types": "./dist/testkit/carmbo-pages-job-testkit.d.ts",
      "import": "./dist/testkit/carmbo-pages-job-testkit.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=26.9.0"
  },
  "files": [
    "src",
    "testkit",
    "dist"
  ],
  "scripts": {
    "build": "run-p 'build:*'",
    "build:typescript": "rm -rf dist && tsc --project tsconfig.build.json",
    "test": "run-p --aggregate-output 'test:*'",
    "test:eslint": "eslint --max-warnings=0 .",
    "test:typescript": "tsc",
    "test:node": "node --test 'test/unit/**/*.test.ts'",
    "test:playwright": "NODE_ENV=test playwright test --config=test/integration"
  },
  "author": "Gil Tayar <gil@tayar.org>",
  "license": "MIT",
  "repository": {
    "url": "https://github.com/giltayar/mono",
    "directory": "packages/carmbo/carmbo-pages-job",
    "type": "git"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com/"
  },
  "peerDependencies": {
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "i18next": "^26.4.2",
    "postgres": "^3.4.7",
    "zod": "^4.6.5"
  },
  "dependencies": {
    "@giltayar/carmbo-common": "^2.0.0",
    "@giltayar/promise-commons": "^2.0.0",
    "async-mutex": "^0.5.0"
  },
  "devDependencies": {
    "@giltayar/docker-compose-testkit": "^2.1.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.12.0",
    "eslint-plugin-n": "^18.4.1",
    "eslint-plugin-prettier": "^5.5.6",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "globals": "^17.13.0",
    "i18next": "^26.4.2",
    "npm-run-all": "^4.1.5",
    "postgres": "3.4.7",
    "prettier": "^3.9.9",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.0",
    "zod": "^4.6.5"
  },
  "packageManager": "pnpm@12.9.1"
}
