# Copy to .env.local and replace this placeholder with your Resend API key.
# Use a full-access key: the standalone app and E2E register a temporary delivery webhook.
RESEND_TEST_API_KEY=xxxxx
# Use Resend's test sender, or replace it with a sender on your verified domain.
RESEND_TEST_FROM=gil@carmbo-dev.tayar.org
# The standalone app also uses these values and sends real emails from its test-email form.
# Production names RESEND_API_KEY and RESEND_FROM take precedence over the TEST alternatives.
# Optional secret for the standalone localhost job execution endpoint.
# JOB_API_SECRET=replace-with-a-local-secret
