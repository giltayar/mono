{
  "name": "@giltayar/carmbo-pages-email",
  "version": "1.0.0",
  "description": "Email sending, delivery tracking, and email pages for Carmbo applications",
  "type": "module",
  "exports": {
    "./routes": {
      "types": "./dist/src/route.d.ts",
      "import": "./dist/src/route.js"
    },
    "./webhook-routes": {
      "types": "./dist/src/webhook-route.d.ts",
      "import": "./dist/src/webhook-route.js"
    },
    "./service": {
      "types": "./dist/src/email-service.d.ts",
      "import": "./dist/src/email-service.js"
    },
    "./jobs": {
      "types": "./dist/src/jobs.d.ts",
      "import": "./dist/src/jobs.js"
    },
    "./testkit/email-service": {
      "types": "./dist/testkit/fake-email-service.d.ts",
      "import": "./dist/testkit/fake-email-service.js"
    },
    "./testkit/page-model/*": {
      "types": "./dist/testkit/page-model/*.d.ts",
      "import": "./dist/testkit/page-model/*.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=26.9.0"
  },
  "files": [
    "src",
    "testkit",
    "dist"
  ],
  "btp": {
    "exclude": [
      "test/**",
      "start/**",
      "AGENTS.md",
      "project.json",
      "eslint.config.mjs",
      ".prettierrc",
      ".gitignore",
      ".env.example"
    ]
  },
  "scripts": {
    "prestart": "rm -rf start/dist && mkdir -p start/dist && concurrently 'node:prestart:*'",
    "prestart:bootstrap": "cp node_modules/bootstrap/dist/css/bootstrap.min.css node_modules/bootstrap/dist/css/bootstrap.rtl.min.css node_modules/bootstrap/dist/js/bootstrap.bundle.min.js start/dist/",
    "prestart:htmx": "cp node_modules/htmx.org/dist/htmx.min.js start/dist/",
    "prestart:client": "pnpm build:client",
    "start": "concurrently --kill-others 'node:start:*'",
    "start:app": "node --watch start/start.ts",
    "start:postgres": "docker compose --file start/docker-compose.yaml up",
    "stop": "docker compose --file start/docker-compose.yaml down",
    "build": "pnpm clean && concurrently 'node:build:*'",
    "clean": "rm -rf dist",
    "build:typescript": "tsc --project tsconfig.build.json",
    "build:client": "esbuild src/templates/client/editor.tsx --bundle --platform=browser --format=esm --minify --target=es2022 --outdir=dist/browser/email-template",
    "test": "concurrently 'node:test:*'",
    "test:eslint": "eslint --max-warnings=0 .",
    "test:typescript": "tsc",
    "test:node": "node --test 'test/unit/**/*.test.ts'",
    "test:playwright": "NODE_ENV=test playwright test --config=test/integration",
    "test:e2e": "NODE_ENV=test playwright test --config=test/e2e"
  },
  "author": "Gil Tayar <gil@tayar.org>",
  "license": "MIT",
  "repository": {
    "url": "https://github.com/giltayar/mono",
    "directory": "packages/carmbo/carmbo-pages-email",
    "type": "git"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com/"
  },
  "peerDependencies": {
    "@playwright/test": "^1.63.0",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "i18next": "^26.4.2",
    "postgres": "^3.4.7",
    "zod": "^4.6.5"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-toolbar": "^1.2.1",
    "@giltayar/carmbo-commons": "^2.4.1",
    "@giltayar/carmbo-pages-job": "^1.0.5",
    "@react-email/editor": "^1.8.1",
    "@tiptap/core": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "handlebars": "^4.7.10",
    "parse5": "^8.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.37.0",
    "standardwebhooks": "^1.1.1"
  },
  "devDependencies": {
    "@fastify/formbody": "^9.0.1",
    "@fastify/request-context": "^7.0.5",
    "@fastify/static": "10.1.8",
    "@giltayar/docker-compose-testkit": "^2.1.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "bootstrap": "^5.3.8",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-prettier": "^5.5.7",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "globals": "^17.14.0",
    "htmx.org": "^2.0.11",
    "i18next": "^26.7.2",
    "postgres": "3.4.7",
    "prettier": "^3.9.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "zod": "^4.6.7"
  },
  "packageManager": "pnpm@12.16.1"
}
