{
  "name": "@giltayar/carmbo-commons",
  "version": "2.3.0",
  "description": "Shared helpers, layout, assets, and database migrations for Carmbo applications",
  "type": "module",
  "exports": {
    "./commons/*": {
      "types": "./dist/src/commons/*.d.ts",
      "import": "./dist/src/commons/*.js"
    },
    "./layout/assets": {
      "types": "./dist/src/layout/assets.d.ts",
      "import": "./dist/src/layout/assets.js"
    },
    "./layout/banner": {
      "types": "./dist/src/layout/banner.d.ts",
      "import": "./dist/src/layout/banner.js"
    },
    "./layout/main-view": {
      "types": "./dist/src/layout/main-view.d.ts",
      "import": "./dist/src/layout/main-view.js"
    },
    "./layout/resources": {
      "types": "./dist/src/layout/resources.d.ts",
      "import": "./dist/src/layout/resources.js"
    },
    "./sql/migration": {
      "types": "./dist/src/sql/migration.d.ts",
      "import": "./dist/src/sql/migration.js"
    },
    "./testkit/page-model/*": {
      "types": "./dist/testkit/page-model/*.d.ts",
      "import": "./dist/testkit/page-model/*.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=26.9.0"
  },
  "files": [
    "src",
    "testkit",
    "dist"
  ],
  "scripts": {
    "build": "pnpm clean && concurrently 'pnpm:build:*'",
    "clean": "rm -rf dist",
    "build:typescript": "tsc --project tsconfig.build.json",
    "build:assets": "mkdir -p dist/src/layout && cp -R src/layout/locale src/layout/style dist/src/layout/",
    "build:sql": "mkdir -p dist/src/sql && cp src/sql/*.sql dist/src/sql/ && cp -R src/sql/maintenance dist/src/sql/",
    "test": "concurrently 'pnpm:test:*'",
    "test:eslint": "eslint --max-warnings=0 .",
    "test:typescript": "tsc",
    "test:integration": "node --test 'test/integration/**/*.test.ts'",
    "test:node": "node --test 'test/unit/**/*.test.ts'"
  },
  "author": "Gil Tayar <gil@tayar.org>",
  "license": "MIT",
  "repository": {
    "url": "https://github.com/giltayar/mono",
    "directory": "packages/carmbo/carmbo-commons",
    "type": "git"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com/"
  },
  "peerDependencies": {
    "@fastify/request-context": "^7.0.0",
    "@playwright/test": "^1.63.0",
    "fastify": "^5.12.5",
    "i18next": "^26.4.2"
  },
  "dependencies": {
    "@fastify/static": "^10.1.8",
    "@giltayar/carmel-tools-ravmesser-integration": "^1.0.0",
    "@giltayar/carmel-tools-smoove-integration": "^5.3.1",
    "@giltayar/carmel-tools-whatsapp-integration": "^2.6.1",
    "@giltayar/functional-commons": "^2.2.1",
    "htm": "^3.1.1",
    "i18next-fs-backend": "^2.6.9",
    "p-retry": "^8.0.1",
    "postgres": "3.4.7",
    "vhtml": "^2.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fastify/request-context": "^7.0.5",
    "@giltayar/docker-compose-testkit": "^2.1.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/vhtml": "^2.2.9",
    "@typescript/native": "npm:typescript@^7.0.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-prettier": "^5.5.7",
    "fastify": "^5.12.7",
    "globals": "^17.12.0",
    "i18next": "^26.5.11",
    "prettier": "^3.9.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1"
  },
  "packageManager": "pnpm@12.16.1"
}