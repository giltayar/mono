{
  "name": "@giltayar/monnaie-app",
  "version": "1.6.0",
  "description": "A mobile-first web app that tracks expenses",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/app/index.ts"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "files": [
    "src",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "run-p 'start:local:*'",
    "start:local:docker-compose": "docker compose up -d",
    "start:local:app": "node $INSPECT_APP --watch ./src/app/index.ts",
    "stop": "docker compose down",
    "build": "mkdir -p dist && rm -rf dist/* && FORCE_COLOR=1 run-p 'build:*'",
    "build:htmx": "mkdir -p dist && cp node_modules/htmx.org/dist/htmx.min.js dist/htmx.min.js",
    "postbuild": "run-p 'postbuild:*'",
    "postbuild:docker": "docker build --platform linux/amd64 -t giltayar/monnaie-app:$npm_package_version . --secret id=npmrc,src=$HOME/.npmrc",
    "pretest": "pnpm run build:htmx",
    "test": "FORCE_COLOR=1 run-p --aggregate-output 'test:*'",
    "test:eslint": "eslint --max-warnings=0 .",
    "test:typescript": "tsgo",
    "test:node": "node --test 'test/unit/**/*.test.ts'",
    "test:playwright": "NODE_ENV=test playwright test --config=test/integration",
    "test:e2e": "playwright test --config=test/e2e",
    "playwright:install": "playwright install --with-deps",
    "postpublish": "docker push giltayar/monnaie-app:$npm_package_version"
  },
  "keywords": [
    "javascript",
    "nodejs"
  ],
  "author": "Gil Tayar <gil@tayar.org>",
  "license": "MIT",
  "repository": {
    "url": "https://github.com/giltayar/mono",
    "directory": "packages/monnaie/monnaie-app",
    "type": "git"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/formbody": "^9.0.0",
    "@fastify/request-context": "^7.0.0",
    "@fastify/static": "^10.1.3",
    "fastify": "^5.12.1",
    "fastify-type-provider-zod": "^7.0.0",
    "firebase-admin": "^14.3.0",
    "htm": "^3.1.1",
    "htmx.org": "^2.0.10",
    "i18next": "^26.4.0",
    "i18next-fs-backend": "^2.6.7",
    "kysely": "^0.29.5",
    "pg": "^8.23.0",
    "vhtml": "^2.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@giltayar/docker-compose-testkit": "^2.1.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/vhtml": "^2.2.9",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "eslint": "^10.8.1",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.11.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.67.0"
  }
}