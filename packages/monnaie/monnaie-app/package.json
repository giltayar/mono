{
  "name": "@giltayar/monnaie-app",
  "version": "0.1.0",
  "description": "A mobile-first web app that tracks expenses",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/app/index.ts"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "files": [
    "src",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node $INSPECT_APP --watch ./src/app/index.ts",
    "build": "mkdir -p dist && rm -rf dist/* && FORCE_COLOR=1 run-p 'build:*'",
    "build:htmx": "mkdir -p dist && cp node_modules/htmx.org/dist/htmx.min.js dist/htmx.min.js",
    "postbuild": "run-p 'postbuild:*'",
    "postbuild:docker": "docker build --platform linux/amd64 -t giltayar/monnaie-app:$npm_package_version . --secret id=npmrc,src=$HOME/.npmrc",
    "pretest": "pnpm run build:htmx",
    "test": "FORCE_COLOR=1 run-p --aggregate-output 'test:*'",
    "test:eslint": "eslint --max-warnings=0 .",
    "test:typescript": "tsgo",
    "test:playwright": "NODE_ENV=test playwright test --config=test/integration",
    "test:e2e": "playwright test --config=test/e2e",
    "postpublish": "docker push giltayar/monnaie-app:$npm_package_version"
  },
  "keywords": [
    "javascript",
    "nodejs"
  ],
  "author": "Gil Tayar <gil@tayar.org>",
  "license": "MIT",
  "repository": {
    "url": "https://github.com/giltayar/mono",
    "directory": "packages/monnaie/monnaie-app",
    "type": "git"
  },
  "dependencies": {
    "@fastify/formbody": "^8.0.2",
    "@fastify/static": "^10.1.0",
    "fastify": "^5.10.0",
    "fastify-type-provider-zod": "^7.0.0",
    "htm": "^3.1.1",
    "htmx.org": "^2.0.10",
    "vhtml": "^2.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@giltayar/docker-compose-testkit": "^2.1.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^26.1.1",
    "@types/vhtml": "^2.2.9",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "eslint": "^10.7.0",
    "eslint-plugin-n": "^18.2.2",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.65.0"
  }
}
